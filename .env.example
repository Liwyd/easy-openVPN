# =============================================================================
# eovpanel — Consolidated Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# Used by: backend (FastAPI), frontend (nginx), and docker-compose.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_NAME=eovpanel
APP_VERSION=0.1.0
DEBUG=false

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Marzban-style single panel port — serves the frontend, the API, AND the
# subscription page. The backend is proxied internally by nginx, so this is the
# only port you need to open. Default 8000; change if already in use.
PANEL_PORT=8000
# Optional: port for HTTPS (only used when TLS certs are mounted).
PANEL_SSL_PORT=443

# --- Database ----------------------------------------------------------------
# SQLite (default) — data persists via Docker named volume at /app/data/
DATABASE_URL=sqlite:///./data/eovpanel.db
#
# PostgreSQL — uncomment below and use docker-compose.postgres.yml
# DATABASE_URL=postgresql://eovpanel:eovpanel@postgres:5432/eovpanel

# --- JWT Authentication ------------------------------------------------------
# IMPORTANT: Change JWT_SECRET_KEY to a long random string in production.
#   Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins. For Docker, the frontend is served
# from the same origin (nginx on port 80/443), so CORS is not needed.
# Only set this if you access the API from a different origin (e.g., dev mode).
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# --- Bootstrap Admin ---------------------------------------------------------
# The first admin created on startup (idempotent). Change credentials immediately.
SUDO_USERNAME=admin
SUDO_PASSWORD=admin

# --- OpenVPN Paths (host paths, mounted into Docker) -------------------------
# These paths must exist on the host, created by vpn-core's setup_server.sh.
OPENVPN_MANAGEMENT_SOCKET=/run/openvpn/management.sock
OPENVPN_STATUS_LOG=/etc/openvpn/status.log
EASYRSA_DIR=/etc/openvpn/easy-rsa

# --- Telegram Bot (optional) -------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# --- Docker / TLS (optional) -------------------------------------------------
# Set to the domain name if using TLS certs from erfjab/ESSL.
# TLS_CERT_PATH=/etc/nginx/ssl/fullchain.pem
# TLS_KEY_PATH=/etc/nginx/ssl/privkey.pem

# --- Docker Images -----------------------------------------------------------
# Docker Hub username for pulling prebuilt images.
DOCKERHUB_USERNAME=liwyd
# Image tag: "latest" or a specific git SHA for pinning/rollback.
IMAGE_TAG=latest

# --- PostgreSQL (used by docker-compose.postgres.yml) ------------------------
POSTGRES_PASSWORD=eovpanel
