# =============================================================================
# eovpanel — Backend Environment Configuration
# =============================================================================
# NOTE: For production Docker deployments, use the consolidated .env.example
# at the repo root instead. This file is for local development only.
# =============================================================================

# App
APP_NAME=eovpanel
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite default, use postgresql:// for Postgres)
DATABASE_URL=sqlite:///./eovpanel.db

# JWT
JWT_SECRET_KEY=changeme-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Bootstrap admin (created on first startup)
SUDO_USERNAME=admin
SUDO_PASSWORD=admin

# OpenVPN paths (host paths, mounted into Docker)
OPENVPN_MANAGEMENT_SOCKET=/run/openvpn/management.sock
OPENVPN_STATUS_LOG=/opt/eovpanel/vpn/status.log
EASYRSA_DIR=/opt/eovpanel/vpn/easy-rsa

# Telegram (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
