# App
APP_NAME=eovpanel
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite default, use postgresql:// for Postgres)
DATABASE_URL=sqlite:///./eovpanel.db

# JWT
JWT_SECRET_KEY=changeme-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenVPN paths (host paths, mounted into Docker)
OPENVPN_MANAGEMENT_SOCKET=/run/openvpn/management.sock
OPENVPN_STATUS_LOG=/etc/openvpn/status.log
EASYRSA_DIR=/etc/openvpn/easy-rsa

# Telegram (optional, not wired yet)
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=
