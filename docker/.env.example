# =============================================================================
# eovpanel — Docker Environment Configuration
# =============================================================================
# NOTE: For production, use the consolidated .env.example at the repo root.
# This file is kept for backward compatibility.
# =============================================================================

# App
APP_NAME=eovpanel
APP_VERSION=0.1.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
# Marzban-style single panel port — serves frontend + API + subscriptions.
PANEL_PORT=8000
# Optional: port for HTTPS (only used when TLS certs are mounted).
PANEL_SSL_PORT=443
# Optional base path (e.g. dashboard) — panel is served only at /dashboard,
# the root returns 404 (hides the panel from scanners). Empty = root.
APP_BASE_PATH=

# Database (SQLite default, use postgresql:// for Postgres)
DATABASE_URL=sqlite:///./data/eovpanel.db

# JWT
JWT_SECRET_KEY=changeme-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost

# Bootstrap admin
SUDO_USERNAME=admin
SUDO_PASSWORD=admin

# OpenVPN paths (host paths, mounted into Docker)
OPENVPN_MANAGEMENT_SOCKET=/run/openvpn/management.sock
OPENVPN_STATUS_LOG=/etc/openvpn/status.log
EASYRSA_DIR=/etc/openvpn/easy-rsa

# Telegram (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
